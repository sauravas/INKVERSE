# Copy to .env and edit, or just set these in your shell. All are optional.

# --- provider ---------------------------------------------------------------
# local = two-stage pipeline (default), heavy = one big model, gemini = cloud
INKWISE_PROVIDER=local

# Stage 1 transcribes handwriting, stage 2 reasons. Both must be pulled already.
INKWISE_VISION_MODEL=gemma3:4b
INKWISE_TEXT_MODEL=qwen2.5:14b
# Used only when INKWISE_PROVIDER=heavy
INKWISE_HEAVY_MODEL=gemma4:26b

OLLAMA_URL=http://127.0.0.1:11434
INKWISE_NUM_CTX=8192
INKWISE_KEEP_ALIVE=10m

# Read numeric questions twice and flag any disagreement, so a misread
# coefficient (4x^2 seen as 2x^2) is caught. Costs a second vision pass.
INKWISE_VERIFY_MATH=1

# --- memory guard -----------------------------------------------------------
# Refuse to load a model that would leave less than this much RAM free.
INKWISE_MIN_FREE_RAM_GB=3.0
INKWISE_RAM_GUARD=1
# Keep only one pipeline stage in memory at a time. Needed on a shared-memory
# GPU, where vision + text together crash the runner during image encoding.
INKWISE_EXCLUSIVE_MODELS=1
# If the text model will not fit, answer with the smaller vision model and say
# so, instead of failing the request.
INKWISE_LOW_MEMORY_FALLBACK=1
# Start Ollama automatically if it is not running.
INKWISE_AUTOSTART_OLLAMA=1

# --- optional cloud fallback ------------------------------------------------
# Never hardcode this in the repo. Nothing is uploaded without in-app consent.
# GEMINI_API_KEY=
INKWISE_GEMINI_MODEL=gemini-2.5-flash

# --- network ----------------------------------------------------------------
INKWISE_PORT=8000
# Set to 5173 when running the Vite dev server, so the phone QR points there.
# INKWISE_PUBLIC_PORT=5173
# Override LAN IP detection if the QR shows the wrong address.
# INKWISE_PUBLIC_HOST=192.168.0.177

# --- web search --------------------------------------------------------------
# Optional. With a Tavily key, "Web on" searches the open web through an API
# built for LLMs instead of only Wikipedia + DuckDuckGo. Paste the key here.
# It is read from the environment, never written back, and never returned by
# any endpoint. Web search only ever sends the question text - never your
# handwriting, your notes or anything you have imported.
TAVILY_API_KEY=
# basic = fast and cheap, advanced = slower and better for exam questions
INKWISE_TAVILY_DEPTH=basic
INKWISE_TAVILY_RESULTS=5

# --- importing ---------------------------------------------------------------
# Full path to tesseract.exe if it is not on PATH or in C:\Program Files\Tesseract-OCR
# INKWISE_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# Read at most this many pages of an imported PDF
INKWISE_IMPORT_MAX_PAGES=80

# --- voice ------------------------------------------------------------------
# whisperflow runs as a sidecar in speech/.venv (its own Python, PyTorch and
# FastAPI pins). INKWISE relays audio to it and starts it on first use.
INKWISE_SPEECH_URL=ws://127.0.0.1:8181/ws
INKWISE_AUTOSTART_SPEECH=1
# INKWISE_SPEECH_PYTHON=C:\INKWISE\speech\.venv\Scripts\python.exe
